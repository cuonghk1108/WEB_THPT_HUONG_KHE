# ====== SUPABASE CONFIGURATION (PostgreSQL) ======
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ====== FIREBASE CONFIGURATION (Alternative) ======
# Lấy các giá trị này từ Firebase Console: https://console.firebase.google.com/

# API Key từ Firebase Console
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Auth Domain
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID
VITE_FIREBASE_PROJECT_ID=your_project_id

# Firebase Storage Bucket
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase App ID
VITE_FIREBASE_APP_ID=1:your_app_id_here

# Firebase Realtime Database URL
VITE_FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# ====== CLOUDINARY CONFIGURATION ======
# Lấy từ: https://cloudinary.com/

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ====== MONGODB BACKEND (REST + SOCKET.IO) ======
VITE_API_URL=https://your-backend-domain/api
VITE_SOCKET_URL=https://your-backend-domain

# ====== GOOGLE GEMINI CONFIGURATION (Tùy chọn) ======
# Lấy từ: https://makersuite.google.com/app/apikey

VITE_GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
