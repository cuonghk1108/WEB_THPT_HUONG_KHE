# ==========================================
# 🔐 BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database
# ⚠️ NEVER commit real credentials! Replace with your actual MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appname>
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/your-database?appName=YourApp

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
JWT_EXPIRE=7d

# Admin Credentials (for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=demo  # In production: use bcrypt hash

# Email Service (Gmail or other SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password  # For Gmail: use App Password
ADMIN_EMAIL=admin@thpthuongkhe.edu.vn

# Frontend URLs (for CORS & email links)
FRONTEND_URL=http://localhost:5173
FRONTEND_PRODUCTION_URL=https://thpthuongkhe.vercel.app

# ==========================================
# 🎨 FRONTEND ENVIRONMENT VARIABLES
# ==========================================

# API Configuration
VITE_API_URL=http://localhost:5000
VITE_API_PRODUCTION_URL=https://api.thpthuongkhe.edu.vn  # Or your backend URL

# Cloud Services
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# JSONBin Configuration
VITE_JSONBIN_API_KEY=your-jsonbin-api-key
VITE_JSONBIN_BIN_ID=your-school-data-bin-id
VITE_VISITOR_BIN_ID=your-visitor-counter-bin-id

# AI Services
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GROK_API_KEY=your-grok-api-key  # xAI API key

# Features
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_DARK_MODE=true

# ==========================================
# 📝 NOTES FOR SETUP
# ==========================================

# 1. JWT_SECRET: Generate a random string (minimum 32 characters)
#    Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# 2. EMAIL_PASSWORD: For Gmail, use App Password (not your regular password)
#    Steps: Enable 2FA → Go to myaccount.google.com → Create App Password

# 3. SUPABASE_ANON_KEY: Get from Supabase project settings
#    Make sure Storage buckets are public

# 4. CLOUDINARY_UPLOAD_PRESET: Create unsigned upload preset in Cloudinary

# 5. JSONBIN_API_KEY: Get from jsonbin.io dashboard
#    Create bins for school data and visitor counter

# 6. GROK_API_KEY: Get from https://console.x.ai/
#    For xAI Grok API

# ==========================================
