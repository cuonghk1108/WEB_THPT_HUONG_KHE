# Gemini API Key (Server-side only - SECURE)
# Lấy API key từ: https://aistudio.google.com/app/apikey
# KHÔNG sử dụng prefix VITE_ để bảo vệ API key khỏi bị lộ ra client
GEMINI_API_KEY=your_api_key_here

# JSONBin.io API Key & Bin ID
# Tạo account và bin tại: https://jsonbin.io
VITE_JSONBIN_API_KEY=your_jsonbin_api_key_here
VITE_JSONBIN_BIN_ID=your_jsonbin_bin_id_here
VITE_VISITOR_BIN_ID=your_visitor_bin_id_here

# Cloudinary Configuration
# Tạo account miễn phí tại: https://cloudinary.com
# Free tier: 25GB storage, 25GB bandwidth/tháng
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=school_uploads
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key_here
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
# Supabase Configuration
# Create free account at: https://supabase.com
# Get credentials from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY is server-side ONLY - set in Vercel env, NEVER commit to git

# MongoDB + Node.js Backend (REST + Socket.io)
VITE_API_URL=https://your-backend-domain/api
VITE_SOCKET_URL=https://your-backend-domain